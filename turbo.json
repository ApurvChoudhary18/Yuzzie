{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "bench": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
