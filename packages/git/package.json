{
  "name": "@yuzie/git",
  "version": "0.1.0",
  "description": "Git repository introspection: branches, commits, hooks, and editor resolution.",
  "keywords": [
    "yuzie",
    "git",
    "hooks",
    "branches"
  ],
  "license": "MIT",
  "author": {
    "name": "Apurv Choudhary",
    "url": "https://github.com/ApurvChoudhary18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApurvChoudhary18/Yuzzie.git",
    "directory": "packages/git"
  },
  "homepage": "https://github.com/ApurvChoudhary18/Yuzzie#readme",
  "bugs": {
    "url": "https://github.com/ApurvChoudhary18/Yuzzie/issues"
  }
}
