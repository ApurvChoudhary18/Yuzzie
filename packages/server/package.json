{
  "name": "@yuzie/server",
  "version": "0.1.0",
  "description": "Fastify REST API, WebSocket gateway, and persistence for Yuzie.",
  "keywords": [
    "yuzie",
    "kanban",
    "server",
    "fastify",
    "websocket",
    "postgres",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yuzie-server": "./bin/yuzie-server.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "src/db/migrations"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "start": "node bin/yuzie-server.js",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts",
    "load": "vitest run --config vitest.load.config.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^11.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@prometheus-io/client": "^0.16.1",
    "@yuzie/core": "workspace:^",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApurvChoudhary18/Yuzzie.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/ApurvChoudhary18/Yuzzie#readme",
  "bugs": {
    "url": "https://github.com/ApurvChoudhary18/Yuzzie/issues"
  }
}
