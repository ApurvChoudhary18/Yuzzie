{
  "name": "@yuzie/server",
  "version": "0.1.0",
  "description": "Fastify REST API, WebSocket gateway, and persistence for Yuzie.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/db/migrations"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "start": "node --input-type=module -e \"import('./dist/index.js').then((server) => server.start())\"",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^11.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@prometheus-io/client": "^0.16.1",
    "@yuzie/core": "workspace:^",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
