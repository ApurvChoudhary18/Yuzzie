{
  "name": "@yuzie/cli",
  "version": "0.1.0",
  "description": "The yuzie command-line interface and interactive TUI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "yuzie": "./dist/index.js",
    "yz": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@yuzie/core": "workspace:^",
    "@yuzie/git": "workspace:^",
    "@yuzie/sdk": "workspace:^",
    "@yuzie/store": "workspace:^",
    "commander": "^14.0.3",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
