{
  "name": "@yuzie/cli",
  "version": "0.1.0",
  "description": "The yuzie command-line interface and interactive TUI.",
  "keywords": [
    "yuzie",
    "kanban",
    "cli",
    "tui",
    "terminal",
    "git",
    "project-management",
    "task-tracker"
  ],
  "license": "MIT",
  "author": {
    "name": "Apurv Choudhary",
    "url": "https://github.com/ApurvChoudhary18"
  },
  "type": "module",
  "bin": {
    "yuzie": "./dist/index.js",
    "yz": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "budget": "node bench/size-budget.mjs && node bench/startup-budget.mjs",
    "docs:commands": "YUZIE_UPDATE_DOCS=1 vitest run src/reference.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@yuzie/core": "workspace:^",
    "@yuzie/git": "workspace:^",
    "@yuzie/mcp": "workspace:^",
    "@yuzie/sdk": "workspace:^",
    "@yuzie/store": "workspace:^",
    "commander": "^14.0.3",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApurvChoudhary18/Yuzzie.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ApurvChoudhary18/Yuzzie#readme",
  "bugs": {
    "url": "https://github.com/ApurvChoudhary18/Yuzzie/issues"
  }
}
