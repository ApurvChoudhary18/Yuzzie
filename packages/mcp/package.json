{
  "name": "@yuzie/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing a Yuzie board to AI agents.",
  "keywords": [
    "yuzie",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "kanban"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@yuzie/core": "workspace:^",
    "@yuzie/git": "workspace:^",
    "@yuzie/sdk": "workspace:^",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApurvChoudhary18/Yuzzie.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/ApurvChoudhary18/Yuzzie#readme",
  "bugs": {
    "url": "https://github.com/ApurvChoudhary18/Yuzzie/issues"
  }
}
