{
  "name": "@yuzie/sdk",
  "version": "0.1.0",
  "description": "Typed programmatic client for the Yuzie API \u2014 HTTP, realtime, and offline queue.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && tsd",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@yuzie/store": "workspace:^",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "tsd": "^0.33.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@yuzie/core": "workspace:^",
    "zod": "^4.6.5"
  },
  "tsd": {
    "directory": "test-d"
  }
}
