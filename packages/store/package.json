{
  "name": "@yuzie/store",
  "version": "0.1.0",
  "description": "Local SQLite cache and offline outbox for the Yuzie CLI.",
  "keywords": [
    "yuzie",
    "sqlite",
    "cache",
    "offline"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@yuzie/core": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApurvChoudhary18/Yuzzie.git",
    "directory": "packages/store"
  },
  "homepage": "https://github.com/ApurvChoudhary18/Yuzzie#readme",
  "bugs": {
    "url": "https://github.com/ApurvChoudhary18/Yuzzie/issues"
  }
}
