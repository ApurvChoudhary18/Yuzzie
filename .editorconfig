# Editors' defaults for this repository; Biome (biome.json) is what CI enforces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# A trailing double space is a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
